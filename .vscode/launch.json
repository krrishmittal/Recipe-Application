{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Recipe.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Recipe.Api",
      "program": "${workspaceFolder}/Recipe.Api/bin/Debug/net8.0/Recipe.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Recipe.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "swagger",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}/swagger"
        }
      }
    }
  ]
}
